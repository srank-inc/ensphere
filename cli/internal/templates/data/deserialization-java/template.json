{
  "name": "deserialization-java",
  "description": "Java deserialization measurement — send serialized object headers and timing payloads and record response observations",
  "vuln_type": "deserialization",
  "technique": "deserialization_rce",
  "risk": 4,
  "run_command": "python3 probe.py",
  "observation_fields": ["baseline_rounds", "deserialization_probes", "deserialization_probes[].matched_error_signatures", "content_type_acceptance"],
  "params": [
    {"name": "TARGET_URL", "description": "Base URL of the application", "example": "http://localhost:8080", "required": true},
    {"name": "ENDPOINT", "description": "Endpoint path that accepts serialized data", "example": "/api/import", "required": true},
    {"name": "AUTH_HEADER", "description": "Authorization header value", "example": "Bearer eyJ...", "required": false}
  ],
  "files": ["probe.py", "README.md"]
}

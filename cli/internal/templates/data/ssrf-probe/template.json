{
  "name": "ssrf-probe",
  "description": "SSRF detection — send internal URL payloads and compare responses to external baseline",
  "vuln_type": "ssrf",
  "technique": "internal_service",
  "risk": 2,
  "run_command": "python3 probe.py",
  "observation_fields": ["baseline", "probes", "probes[].matched_signatures", "probes[].response_snippet"],
  "params": [
    {"name": "TARGET_URL", "description": "URL that accepts a URL parameter", "example": "http://localhost:3000/api/fetch?url=", "required": true},
    {"name": "PARAM", "description": "Parameter name that takes the URL value", "example": "url", "required": true},
    {"name": "AUTH_HEADER", "description": "Authorization header value", "example": "Bearer eyJ...", "required": false},
    {"name": "EXTERNAL_URL", "description": "Known external URL for baseline", "example": "https://httpbin.org/get", "required": false}
  ],
  "files": ["probe.py", "README.md"]
}

{
  "name": "auth-header-replay",
  "description": "Authentication header replay — test if one user's token grants access to another user's data",
  "vuln_type": "authz",
  "technique": "cross_tenant",
  "auth_method": "bearer",
  "risk": 3,
  "run_command": "python3 exploit.py",
  "success_signals": ["status_code:200", "body_contains:user_b_data"],
  "params": [
    {"name": "BASE_URL", "description": "Target base URL", "example": "https://app.example.com", "required": true},
    {"name": "ENDPOINTS", "description": "Comma-separated API endpoints to test", "example": "/api/profile,/api/invoices,/api/settings", "required": true},
    {"name": "TOKEN_A", "description": "Bearer token for user A", "example": "eyJ...", "required": true},
    {"name": "TOKEN_B", "description": "Bearer token for user B", "example": "eyJ...", "required": true}
  ],
  "files": ["exploit.py", "README.md"]
}

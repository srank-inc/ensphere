{
  "name": "upload-polyglot-check",
  "description": "File upload validation bypass — test mismatched content-type and extension combinations",
  "vuln_type": "file_upload",
  "technique": "content_type_mismatch",
  "risk": 2,
  "run_command": "python3 probe.py",
  "observation_fields": ["test_results", "status_code", "elapsed_ms", "body_hash", "body_length"],
  "params": [
    {"name": "UPLOAD_URL", "description": "File upload endpoint URL", "example": "http://localhost:3000/api/upload", "required": true},
    {"name": "AUTH_HEADER", "description": "Authorization header value", "example": "Bearer eyJ...", "required": false},
    {"name": "FIELD_NAME", "description": "Form field name for file upload", "example": "file", "required": false}
  ],
  "files": ["probe.py", "README.md"]
}

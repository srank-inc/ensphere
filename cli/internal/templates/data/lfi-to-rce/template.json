{
  "name": "lfi-to-rce",
  "description": "Local file inclusion via directory traversal — send path traversal payloads and check for known file signatures in responses",
  "vuln_type": "lfi",
  "technique": "directory_traversal",
  "risk": 3,
  "run_command": "python3 probe.py",
  "observation_fields": ["baseline", "traversal_probes", "traversal_probes[].matched_signatures", "traversal_probes[].length_delta"],
  "params": [
    {"name": "TARGET_URL", "description": "URL with file inclusion parameter", "example": "http://localhost:3000/view", "required": true},
    {"name": "PARAM", "description": "Parameter name that takes a file path", "example": "file", "required": true},
    {"name": "OS", "description": "Target OS: linux or windows", "example": "linux", "required": false}
  ],
  "files": ["probe.py", "README.md"]
}
